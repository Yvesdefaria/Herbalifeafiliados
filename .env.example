# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (rellenar cuando crees el proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma → Supabase Postgres)
# IMPORTANTE: usar el connection string del POOLER (IPv4).
# El host directo db.<ref>.supabase.co es IPv6-only y falla en redes sin IPv6.
# Formato: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Stripe (modo test)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Opcional: email admin bootstrap
# ADMIN_EMAIL=
